generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, citext]
}

// ───────── ENUMS ─────────
enum UserRole {
  CANDIDATE
  EMPLOYER
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

enum CompanyType {
  LOCAL
  FOREIGN
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum JobMarket {
  LOCAL
  GULF
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

/// Length of a CONTRACT engagement, as a BAND rather than an exact figure.
///
/// Bands, not a month count, because that is what an employer actually knows at
/// posting time — "roughly six months to a year" is honest, while storing `9`
/// invents a precision nobody stated. The bands are contiguous and
/// non-overlapping so a reader can tell two jobs apart without arithmetic.
enum ContractDuration {
  MONTHS_1_6
  MONTHS_6_12
  YEARS_1_2
  YEARS_2_5
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  SELECTED
  REJECTED
}

enum ExperienceType {
  INDIA
  FOREIGN
}

enum DocumentType {
  PASSPORT
  EXPERIENCE_CERT
  EDUCATIONAL_CERT
  WORKING_VIDEO
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum Currency {
  // India + the six GCC states — the original recruiting corridors.
  INR
  QAR
  AED
  SAR
  OMR
  KWD
  BHD
  // Wider corridors. USD was already offered by the Account Settings dropdown
  // while missing from this enum, so choosing "US Dollar" failed validation on
  // save — the UI promised a currency the API rejected.
  USD
  EUR
  GBP
  CAD
  AUD
  JPY
  SGD
  MYR
}

enum Gateway {
  RAZORPAY
  STRIPE
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  GRACE
  EXPIRED
}

enum PlanPeriod {
  FOREVER
  MONTHLY
  YEARLY
}

enum NotificationType {
  APPLICATION_SELECTED
  APPLICATION_SHORTLISTED
  APPLICATION_REJECTED
  NEW_JOB_MATCH
  PROFILE_REMINDER
  JOB_CLOSING_SOON
  PASSPORT_EXPIRY
  PROFILE_VIEWED
  EMPLOYER_APPROVED
  EMPLOYER_REJECTED
  EMPLOYER_SUSPENDED
  SUBSCRIPTION_PURCHASED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  CANDIDATE_MATCHES
  // S6b-B2: job moderation outcomes (employer-facing; email + in-app, no WhatsApp)
  JOB_APPROVED
  JOB_REJECTED
  // S6b-B2: "an admin posted a job on your behalf" — a silent job appearing in
  // the employer's dashboard would be confusing (decision 4)
  JOB_POSTED_ONBEHALF
  RESUME_SENT
  // S7-B2: "your resume PDF is ready" — fired when a generation flips READY so
  // a candidate who navigated away mid-render still learns it finished.
  RESUME_READY
  /// Sent ONCE, the first time a candidate's profile reaches the apply
  /// threshold — the moment they can actually start applying. Confirms the
  /// onboarding they just finished actually landed.
  CANDIDATE_PROFILE_COMPLETE
  /// Sent when an employer finishes company registration. Acknowledges receipt
  /// and sets the expectation of review; EMPLOYER_APPROVED is the later,
  /// separate "you are live" message.
  EMPLOYER_REGISTERED
  /// Emailed password-reset link. SECURITY mail, not a notification: it is
  /// email-only (no in-app row — the recipient cannot sign in to read one, and
  /// a feed entry announcing a reset would leak the event to a session that may
  /// not be theirs) and it ignores the marketing email opt-out.
  PASSWORD_RESET
  /// An employer marked this candidate as one they are interested in and chose
  /// to tell them. Employer-INITIATED outreach, so it is deliberately a
  /// different type from PROFILE_VIEWED (passive, in-app only).
  EMPLOYER_INTERESTED
  /// "Are you still looking?" — sent to a candidate who has not signed in for
  /// 30 days.
  ///
  /// Has NO once-ever guard column. The guard is the notifications table
  /// itself: the scan skips anyone who already has one of these dated AFTER
  /// their `lastLoginAt`. That self-resets the moment they sign in, so each
  /// separate spell of inactivity earns exactly one email and a returning
  /// candidate who lapses again is asked again.
  CANDIDATE_INACTIVE_CHECK_IN
  /// An employer proposed a slot for a live verification call, asking to skip
  /// the 24-hour review queue.
  ///
  /// The FIRST admin-directed notification in the system — every other type
  /// targets the candidate or the employer whose record changed. It fans out to
  /// the staff who actually hold `employers.approve_reject`, because a call
  /// nobody with authority sees is the same as no call at all.
  VERIFICATION_CALL_REQUESTED
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  BOUNCED
}

enum WaMessageKind {
  OTP
  STATUS_UPDATE
  MANUAL_UPDATE
  RESUME_DOCUMENT
}

enum ResumeVisibility {
  DISABLED
  PUBLIC
}

enum ResumeTrigger {
  DOWNLOAD
  WHATSAPP
  EMAIL
}

enum AuditStatus {
  SUCCESS
  FAILED
  BLOCKED
  DELIVERED
  ERROR
}

enum OtpPurpose {
  PHONE_VERIFY
  LOGIN
}

// ───────── IDENTITY & AUTH ─────────
model User {
  id               String     @id @default(uuid())
  email            String     @unique @db.Citext
  passwordHash     String?
  googleId         String?    @unique
  role             UserRole
  status           UserStatus @default(ACTIVE)
  lastLoginAt      DateTime?
  termsAcceptedAt  DateTime?
  deletionDueAt    DateTime?
  // S6b-B1: the purge tombstone marker. Set once by the purge worker when the
  // account has been anonymized in place — status stays PENDING_DELETION (the
  // contract's UserStatus enum is frozen without a PURGED value); purgedAt IS
  // the terminal state, and it is never cleared. Idempotency key for the worker.
  purgedAt         DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  candidateProfile CandidateProfile?
  employerUser     EmployerUser?
  refreshSessions  RefreshSession[]
  notifications    Notification[]
  passwordResetTokens PasswordResetToken[]
  @@index([role, status])
  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

/// Single-use password-reset grant.
///
/// Only the SHA-256 of the token is stored — the raw value exists solely in the
/// emailed link, exactly like OtpChallenge.codeHash. A database leak therefore
/// yields no usable reset tokens.
///
/// `tokenHash` is UNIQUE so a lookup is a single indexed equality probe and can
/// never match two rows; `consumedAt` (not deletion) marks use, so a replayed
/// link is distinguishable from an expired or forged one.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model OtpChallenge {
  id         String     @id @default(uuid())
  phone      String
  userId     String?
  purpose    OtpPurpose @default(PHONE_VERIFY)
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  @@index([phone, purpose, createdAt])
  @@map("otp_challenges")
}

// ───────── CANDIDATE ─────────
model JobCategory {
  id       String  @id @default(uuid())
  slug     String  @unique
  nameEn   String
  nameHi   String?
  nameAr   String?
  isActive Boolean @default(true)
  candidates CandidateProfile[]
  jobs       Job[]
  @@map("job_categories")
}

model CandidateProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  fullName        String
  fatherName      String?
  dob             DateTime?      @db.Date
  phone           String?
  phoneVerifiedAt DateTime?
  whatsappCapable Boolean        @default(false)
  maritalStatus   MaritalStatus?
  religion        String?
  languages       String[]       @default([])
  jobCategoryId   String?
  photoKey        String?
  currentLocation String?
  nationality     String?
  noticePeriod    Int?
  /// Candidate-written intro shown at the TOP of the resume, above personal
  /// details. Their own words about themselves — the one part of the document
  /// the structured fields cannot express. Capped at 500 characters because a
  /// resume summary that runs longer stops being a summary and starts pushing
  /// the work history onto a second page.
  summary         String?        @db.VarChar(500)
  salaryExpectationMin      Int?
  salaryExpectationMax      Int?
  salaryExpectationCurrency Currency?
  isAvailable     Boolean        @default(true)
  profileVisible  Boolean        @default(true)
  showPhone       Boolean        @default(true)
  showReligion    Boolean        @default(false)
  waNotifications Boolean        @default(true)
  emailNotifs     Boolean        @default(true)
  completionPct   Int            @default(0)
  /// Fire-once guard for the profile-completion job-match alert. Set by the
  /// worker AFTER the notification is raised, mirroring `selectedNotifiedAt`:
  /// crossing the threshold again (edit down, edit back up) must never re-send.
  matchAlertSentAt DateTime?
  videoR2Key       String?
  videoDurationSec Int?
  videoSizeBytes   Int?
  videoUploadedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobCategory JobCategory?        @relation(fields: [jobCategoryId], references: [id], onDelete: SetNull)
  experiences WorkExperience[]
  documents   CandidateDocument[]
  skills      CandidateSkill[]
  resume      CandidateResume?
  applications Application[]
  savedJobs   SavedJob[]
  profileViews ProfileView[]
  interests    CandidateInterest[]
  @@index([jobCategoryId, isAvailable])
  @@index([completionPct])
  @@map("candidate_profiles")
}

model WorkExperience {
  id          String         @id @default(uuid())
  candidateId String
  type        ExperienceType
  country     String
  companyName String
  role        String
  years       Int            @default(0)
  months      Int            @default(0)
  startDate   DateTime?      @db.Date
  endDate     DateTime?      @db.Date
  createdAt   DateTime       @default(now())
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  @@index([candidateId, type])
  @@map("work_experiences")
}

model CandidateDocument {
  id          String       @id @default(uuid())
  candidateId String
  type        DocumentType
  r2Key       String
  fileName    String
  mimeType    String
  sizeBytes   Int
  expiryDate  DateTime?    @db.Date
  // S7-B1: the document's own number (passport number for PASSPORT). The home
  // the S7-0 freeze flagged as missing — the resume-view renders it ONLY when
  // showPassportNumber is on; the employer context NEVER selects it.
  documentNumber String?   @db.VarChar(50)
  uploadedAt  DateTime     @default(now())
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  @@unique([candidateId, type])
  @@index([type, expiryDate])
  @@map("candidate_documents")
}

model CandidateSkill {
  id          String @id @default(uuid())
  candidateId String
  name        String
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  @@unique([candidateId, name])
  @@map("candidate_skills")
}

model CandidateResume {
  id                 String           @id @default(uuid())
  candidateId        String           @unique
  language           String           @default("en")
  showPhone          Boolean          @default(true)
  showReligion       Boolean          @default(false)
  showFatherName     Boolean          @default(true)
  showPassportNumber Boolean          @default(false)
  // CLASSIC, not MODERN: this is the template that has always rendered, and
  // defaulting existing rows to a new look would silently change the appearance
  // of resumes candidates have already sent to employers. MODERN is opt-in.
  template           ResumeTemplate   @default(CLASSIC)
  publicSlug         String?          @unique
  visibility         ResumeVisibility @default(DISABLED)
  lastRenderHash     String?
  lastRenderKey      String?
  lastRenderedAt     DateTime?
  updatedAt          DateTime         @updatedAt
  candidate   CandidateProfile   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  generations ResumeGeneration[]
  @@map("candidate_resumes")
}

model ResumeGeneration {
  id               String        @id @default(uuid())
  resumeId         String
  // S7-B1: the generation LIFECYCLE the S7-0 poll serves. The row is created
  // PENDING at enqueue (S7-B2); the worker flips it READY (render fields set)
  // or FAILED (failureReason set). Render fields became nullable because they
  // simply don't exist before the render completes.
  status           ResumeGenerationStatus @default(PENDING)
  failureReason    String?
  contentHash      String?
  r2Key            String?
  sizeBytes        Int?
  trigger          ResumeTrigger
  settingsSnapshot Json
  // S7-B2: the EXACT view the PDF was rendered from (the S7-0 `ResumeView`,
  // photoKey in place of the inlined photo). The status poll serves THIS —
  // rebuilding it from the live profile would drift from the stored bytes the
  // moment the candidate edits their profile, and the contract states the view
  // IS what the PDF contains. Null for pre-S7-B2 rows.
  /// S8: the cover letter rendered from the SAME profile snapshot, in the same
  /// worker job. Kept on the generation rather than in its own table because
  /// the two documents are a matched pair — a letter that quoted a different
  /// snapshot than the CV beside it would contradict it.
  coverLetterR2Key    String?
  coverLetterSizeBytes Int?
  viewSnapshot     Json?
  createdAt        DateTime      @default(now())
  generatedAt      DateTime?
  resume CandidateResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  @@index([resumeId, createdAt])
  @@map("resume_generations")
}

enum ResumeGenerationStatus {
  PENDING
  READY
  FAILED
}

/// Which HTML template renders the resume PDF (CR-001 B1).
///
/// All four values are declared NOW so that B2 — which ships the MODERN,
/// COMPACT and MINIMAL renderers — needs no enum migration. Declaring a value
/// the API does not yet accept is deliberate and safe: the DTO and the OpenAPI
/// enum are the gate, and they list only templates that actually exist, so a
/// client cannot select one that would silently render as something else.
enum ResumeTemplate {
  CLASSIC
  MODERN
  COMPACT
  MINIMAL
  ELEGANT
  EXECUTIVE
  TIMELINE
  SLATE
  HERITAGE
}

// ───────── EMPLOYER ─────────
model Company {
  id                 String        @id @default(uuid())
  name               String
  type               CompanyType
  status             CompanyStatus @default(PENDING)
  registrationNumber String?
  industryType       String
  // Dial code kept in its own column rather than merged into `phone`.
  phoneCode          String?
  phone              String
  // Nullable to stay backward compatible with companies registered before the
  // field existed; the register DTO requires it for every NEW company.
  country            String?
  location           String
  website            String?
  /// Year the company was founded. NULLABLE on purpose: every company that
  /// registered before this field existed has no answer, and backfilling a
  /// guessed year would put a fabricated fact on a profile admins use to
  /// approve employers. The register DTO requires it for every NEW company.
  foundedYear        Int?
  employeeRange      String
  languagePref       String[]      @default([])
  description        String?
  logoKey            String?
  rejectionReason    String?
  approvedAt         DateTime?
  reviewedById       String?
  suspendedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  employerUsers  EmployerUser[]
  contactPersons ContactPerson[]
  documents      CompanyDocument[]
  hiringPrefs    HiringPreference?
  jobs           Job[]
  orders         Order[]
  subscriptions  Subscription[]
  profileViews   ProfileView[]
  interests      CandidateInterest[]
  verificationCall VerificationCallRequest?
  @@index([status, type])
  @@map("companies")
}

/// An employer asking for a live verification call instead of waiting out the
/// standard review queue.
///
/// ONE row per company (`companyId` is unique), so "schedule" and "reschedule"
/// are the same operation: an upsert. Keeping a history of every slot a company
/// ever proposed would grow without bound and buy nothing — the only thing
/// anybody acts on is the slot being asked for now. It also bounds how much
/// noise a single employer can generate for admins, since re-picking a time
/// replaces the request rather than raising a new one.
///
/// Cascade-deleted with the company: this is scheduling state, not a financial
/// record and not an audit trail, so it carries none of the retention rules
/// those tables do.
model VerificationCallRequest {
  id                String   @id @default(uuid())
  companyId         String   @unique
  /// The employer user who asked — kept so an admin knows who to expect on the
  /// call, which is not always the company's primary contact.
  requestedByUserId String
  /// The proposed start, stored UTC like every other timestamp here.
  slotAt            DateTime
  /// Optional context from the employer (a phone number, "after 6pm", …).
  note              String?  @db.VarChar(500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([slotAt])
  @@map("verification_call_requests")
}

model EmployerUser {
  id        String  @id @default(uuid())
  userId    String  @unique
  companyId String
  isPrimary Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId])
  @@map("employer_users")
}

model ContactPerson {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  designation String?
  phone       String?
  email       String?
  hasWhatsapp Boolean  @default(false)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@map("contact_persons")
}

model CompanyDocument {
  id           String    @id @default(uuid())
  companyId    String
  r2Key        String
  fileName     String
  mimeType     String
  sizeBytes    Int
  verifiedAt   DateTime?
  verifiedById String?
  uploadedAt   DateTime  @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@map("company_documents")
}

model HiringPreference {
  id                 String      @id @default(uuid())
  companyId          String      @unique
  categories         String[]    @default([])
  preferredExp       String?
  jobMarketsPosted   JobMarket[] @default([])
  countriesHiredFrom String[]    @default([])
  languagesRequired  String[]    @default([])
  updatedAt          DateTime    @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@map("hiring_preferences")
}

// ───────── JOBS ─────────
model Job {
  id              String         @id @default(uuid())
  humanId         String         @unique @default(dbgenerated("((('JB-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || nextval('job_human_seq'::regclass))"))
  companyId       String
  title           String
  employmentType  EmploymentType @default(FULL_TIME)
  market          JobMarket
  status          JobStatus      @default(DRAFT)
  // Recruiting country (canonical English name, e.g. "India", "United Arab
  // Emirates"). Nullable for expand-safety — pre-feature rows have none — but
  // REQUIRED on create/update via the DTO, and constrained to match `market`
  // (India for LOCAL; the six GCC states for GULF) in the service layer.
  country         String?
  location        String
  description     String
  categoryId      String
  // Free-text trade name, set ONLY when the chosen category is the `other`
  // slug. The FK stays required so every job is still countable and filterable
  // under a real category row; this carries the words the employer typed
  // ("Agentic AI Engineer") that no fixed trade list will ever have. Null for
  // every non-`other` category — the service clears it rather than trusting the
  // client to omit it.
  categoryOther   String?  @db.VarChar(80)
  requirements            String[] @default([])
  experienceRequiredYears Int?
  salaryMin       Int
  salaryMax       Int
  currency        Currency
  accommodation      Boolean @default(true)
  healthInsurance    Boolean @default(true)
  transportation     Boolean @default(true)
  foodAllowance      Boolean @default(false)
  airTicketArrival   Boolean @default(false)
  airTicketDeparture Boolean @default(false)
  otherAllowance     String?
  hoursPerDay          Int
  daysPerWeek          Int
  overtime             Boolean @default(false)
  overtimeRateSubunits Int?
  /// DEPRECATED in favour of `contractDuration`. An exact month count was never
  /// collected by any form and is null on every row; it stays only because it is
  /// already in the public contract. Do not write it from new code.
  contractPeriodMonths Int?
  /// How long a CONTRACT role runs, as the BAND the employer actually chose.
  /// Nullable because it is meaningless for full-time and part-time roles — the
  /// "required exactly when employmentType is CONTRACT" pairing is enforced in
  /// JobsService, which is the only place that can see both fields at once.
  contractDuration     ContractDuration?
  /// WHICH version of the job-posting terms the employer accepted, and when.
  ///
  /// The version string is the point. A bare boolean records that someone
  /// ticked a box but not what the box said, which is exactly the question
  /// asked in a dispute — so the terms are versioned and the version is stamped
  /// onto the row. Nullable for jobs posted before the terms existed; the DTO
  /// requires it for every new job.
  termsVersion         String?
  termsAcceptedAt      DateTime?
  vacancies            Int?
  genderPreference     String?
  isFeatured      Boolean   @default(false)
  isUrgent        Boolean   @default(false)
  publishedAt     DateTime?
  pausedAt        DateTime?
  archivedAt      DateTime?
  autoArchiveAt   DateTime?
  viewsCount      Int       @default(0)
  postedByAdminId String?
  // S6b-B2 moderation trail: set by POST /admin/jobs/{id}/review. The reason is
  // EMPLOYER-VISIBLE (shown on their job row so they can fix and resubmit);
  // cleared on approve, set on reject.
  moderationReason String?  @db.VarChar(500)
  moderatedById    String?
  moderatedAt      DateTime?
  searchVector    Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\"))"))
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category     JobCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  applications Application[]
  savedBy      SavedJob[]
  @@index([status, market, categoryId, publishedAt(sort: Desc)])
  // S8-H1: the LANDING PAGE's shape — `status = 'ACTIVE' ORDER BY publishedAt DESC`
  // with no market/category filter. The composite above cannot serve it: market
  // and categoryId sit between the equality column and the sort column, so an
  // unfiltered recent sort fell back to a Seq Scan over every ACTIVE job plus a
  // top-N sort (10,004 rows / 13.7ms at 10k jobs, growing linearly). With this
  // index the planner does an Index Scan and stops early — 71 rows / 0.7ms.
  @@index([status, publishedAt(sort: Desc)])
  @@index([companyId, status])
  @@index([status, autoArchiveAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([searchVector], type: Gin)
  @@map("jobs")
}

model SavedJob {
  candidateId String
  jobId       String
  createdAt   DateTime @default(now())
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@id([candidateId, jobId])
  @@map("saved_jobs")
}

model ProfileView {
  id          String   @id @default(uuid())
  candidateId String
  companyId   String
  viewedAt    DateTime @default(now())
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([candidateId, viewedAt(sort: Desc)])
  @@map("profile_views")
}

/// An employer marking a candidate as one they are interested in, and the
/// record of whether that candidate has been told.
///
/// SEPARATE from ProfileView (passive, auto-recorded on open) and from
/// Application (candidate-initiated, gated). This one is employer-initiated and
/// deliberate.
model CandidateInterest {
  id          String    @id @default(uuid())
  companyId   String
  candidateId String
  createdAt   DateTime  @default(now())
  /// Fire-once guard for the outreach message. NULL = marked but not yet told.
  /// Set by the WORKER after the notification is raised, so un-marking and
  /// re-marking cannot be used to message a candidate repeatedly.
  notifiedAt  DateTime?
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// One row per (company, candidate) — marking twice is idempotent, and it is
  /// what makes `notifiedAt` a real once-per-employer guard.
  @@unique([companyId, candidateId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("candidate_interests")
}

// ───────── APPLICATIONS ─────────
model Application {
  id                   String            @id @default(uuid())
  humanId              String            @unique @default(dbgenerated("((('AP-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || nextval('application_human_seq'::regclass))"))
  jobId                String
  candidateId          String?
  candidateTombstone   Json?
  status               ApplicationStatus @default(PENDING)
  coverLetter          String?           @db.VarChar(500)
  matchScore           Int
  matchBreakdown       Json
  docsCompleteCount    Int
  docsRequiredCount    Int
  passportValidAtApply Boolean
  selectedNotifiedAt   DateTime?
  rejectionFeedback    String?
  archivedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  candidate CandidateProfile? @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  timeline  ApplicationTimelineEntry[]
  notes     ApplicationNote[]
  @@unique([jobId, candidateId])
  @@index([jobId, status, matchScore(sort: Desc)])
  @@index([candidateId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("applications")
}

model ApplicationTimelineEntry {
  id              String             @id @default(uuid())
  applicationId   String
  fromStatus      ApplicationStatus?
  toStatus        ApplicationStatus
  actorUserId     String?
  actorRole       UserRole?
  isAdminOverride Boolean            @default(false)
  overrideReason  String?
  createdAt       DateTime           @default(now())
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, createdAt])
  @@map("application_timeline")
}

model ApplicationNote {
  id            String   @id @default(uuid())
  applicationId String
  authorId      String
  // S6b-B2: denormalized at write from the actor context — the contract's
  // NoteEntry carries authorRole, and joining users for it would cross a module
  // boundary. Nullable only for migration safety; every write sets it.
  authorRole    UserRole?
  body          String   @db.VarChar(2000)
  createdAt     DateTime @default(now())
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, createdAt])
  @@map("application_notes")
}

// ───────── PAYMENTS & BILLING ─────────
model Plan {
  id            String     @id @default(uuid())
  code          String     @unique
  name          String
  priceSubunits Int
  period        PlanPeriod
  maxActiveJobs Int?
  features      Json
  isActive      Boolean    @default(true)
  orders        Order[]
  subscriptions Subscription[]
  @@map("plans")
}

model Order {
  id             String      @id @default(uuid())
  companyId      String
  planId         String
  gateway        Gateway
  amountSubunits Int
  gstSubunits    Int         @default(0)
  totalSubunits  Int
  currency       Currency    @default(INR)
  gatewayOrderId String?     @unique
  status         OrderStatus @default(CREATED)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plan     Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]
  invoice  Invoice?
  subscription Subscription?
  @@index([companyId, status])
  @@map("orders")
}

model Payment {
  id               String        @id @default(uuid())
  orderId          String
  gatewayPaymentId String        @unique
  method           String?
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?
  rawPayload       Json
  createdAt        DateTime      @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@map("payments")
}

model Subscription {
  id               String             @id @default(uuid())
  companyId        String
  planId           String
  orderId          String?            @unique
  status           SubscriptionStatus @default(ACTIVE)
  startsAt         DateTime
  expiresAt        DateTime?
  graceEndsAt      DateTime?
  renewalReminders Boolean            @default(true)
  createdAt        DateTime           @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([companyId, status, startsAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("subscriptions")
}

model Invoice {
  id       String   @id @default(uuid())
  orderId  String   @unique
  number   String   @unique
  pdfKey   String?
  issuedAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@map("invoices")
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  status      String    @default("RECEIVED")
  @@unique([provider, eventId])
  @@map("webhook_events")
}

// ───────── NOTIFICATIONS ─────────
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model WhatsappMessage {
  id                 String         @id @default(uuid())
  userId             String?
  phone              String
  kind               WaMessageKind
  templateName       String
  waMessageId        String?        @unique
  status             DeliveryStatus @default(QUEUED)
  statusUpdatedAt    DateTime?
  applicationId      String?
  resumeGenerationId String?
  errorCode          String?
  createdAt          DateTime       @default(now())
  @@index([userId, createdAt(sort: Desc)])
  @@index([kind, status])
  @@map("whatsapp_messages")
}

model EmailMessage {
  id           String           @id @default(uuid())
  userId       String?
  toEmail      String
  type         NotificationType
  sesMessageId String?          @unique
  status       DeliveryStatus   @default(QUEUED)
  bounceType   String?
  createdAt    DateTime         @default(now())
  @@index([toEmail, status])
  @@map("email_messages")
}

model NotificationTemplate {
  id               String    @id @default(uuid())
  key              String    @unique
  channel          String
  metaTemplateName String?
  language         String    @default("en")
  body             String?
  approvedAt       DateTime?
  costSubunits     Int?
  updatedAt        DateTime  @updatedAt
  @@map("notification_templates")
}

// ───────── PLATFORM ─────────
model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  isCoreRule  Boolean  @default(false)
  version     Int      @default(1)
  updatedById String?
  updatedAt   DateTime @updatedAt
  @@map("settings")
}

model RolePermission {
  id            String   @id @default(uuid())
  role          UserRole
  permissionKey String
  enabled       Boolean  @default(false)
  isLocked      Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  @@unique([role, permissionKey])
  @@map("role_permissions")
}

model AuditLog {
  id          BigInt      @id @default(autoincrement())
  createdAt   DateTime    @default(now())
  actorUserId String?
  actorRole   UserRole?
  action      String
  module      String
  targetType  String?
  targetId    String?
  ip          String?
  userAgent   String?
  status      AuditStatus
  meta        Json        @default("{}")
  @@index([module, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([createdAt], type: Brin)
  @@map("audit_logs")
}
