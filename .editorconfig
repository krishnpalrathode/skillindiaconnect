# Editor-level enforcement so files are SAVED as LF (complements .gitattributes,
# which enforces LF at the Git layer). Supported natively by most editors/IDEs.
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
