# Runtime environment
NODE_ENV=development
PORT=3001

# PostgreSQL -- matches docker-compose defaults
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/skillindiaconnect_dev

# Redis -- matches docker-compose defaults
REDIS_URL=redis://localhost:6379

# Web app -- origin of the NestJS API server (scheme + host + port, NO trailing slash, NO /api/v1 path).
# The /api/v1 prefix is appended by apps/web/src/lib/api/client.ts at build time.
NEXT_PUBLIC_API_URL=http://localhost:3001

# JWT secrets (min 32 chars each -- generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars-long
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string-at-least-32-ch

# JWT TTLs (optional -- defaults shown)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Google OAuth (candidates only)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# LinkedIn OAuth / OpenID Connect (candidates only) -- OPTIONAL
#
# Leave all three blank and the LinkedIn provider is simply not registered: the
# API boots normally and /auth/linkedin redirects back to the login page with
# ?error=LINKEDIN_UNAVAILABLE. Set all three to turn it on.
#
# Setup, in the LinkedIn Developer Portal (https://www.linkedin.com/developers/apps):
#   1. Create an app and associate it with a LinkedIn Company Page (required).
#   2. Products tab -> request "Sign In with LinkedIn using OpenID Connect".
#      The keys alone are NOT enough; without this product the consent screen
#      rejects the `openid` scope.
#   3. Auth tab -> add the callback URL below to "Authorized redirect URLs".
#      It must match byte for byte, including the scheme and any trailing path.
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/linkedin/callback

# Frontend base URL -- used for OAuth redirect and CORS origin
WEB_APP_URL=http://localhost:3000

# Cloudflare R2 -- S3-compatible object storage for documents, photos, and resumes
# Local dev: point at an R2 dev bucket or a local S3-compatible mock (e.g. MinIO)
# The presign/HEAD logic is identical regardless of which endpoint is used.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=skillindiaconnect-dev
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Payments (S5) -- Razorpay is the locked primary gateway; use TEST-MODE keys in dev.
# Domestic vs international is a Razorpay ACCOUNT-level enablement (dashboard + KYC),
# not an API/code switch.
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Stripe is the OPTIONAL hedge for FOREIGN companies -- the API boots with this blank.
# Routing selects Stripe only when a key is set AND the payments.stripe_enabled
# platform setting is on.
STRIPE_SECRET_KEY=

# Webhook signing secrets (S5-B2). Razorpay's is set in the dashboard when creating
# the webhook; signature verification (HMAC-SHA256 of the RAW body) runs BEFORE any
# parsing. Stripe's is OPTIONAL and pairs with STRIPE_SECRET_KEY (whsec_...).
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
STRIPE_WEBHOOK_SECRET=

# ─── Email channel (behind the neutral EmailChannel port) ───
# EMAIL_PROVIDER selects the adapter: mock (dev/test/CI default) | resend (prod, HTTPS) |
# titan (SMTP) | ses (future). Each provider's own values are required ONLY when it is
# selected (the adapter throws loudly at startup if any is missing). EMAIL_FROM is the
# authorized sender on a domain VERIFIED with the provider — adapter config, never per-call.
# NOTE: the worker host blocks outbound SMTP (465/587/25 time out; :443 open), so PRODUCTION
# uses `resend`; `titan` is kept for hosts that permit SMTP. DNS (SPF/DKIM/DMARC) is the
# deliverability prerequisite either way.
EMAIL_PROVIDER=mock
# Resend (HTTPS) — required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Optional: point tests/staging at a stub; production uses the default endpoint.
RESEND_ENDPOINT=
RESEND_TIMEOUT_MS=10000
# Titan SMTP — required when EMAIL_PROVIDER=titan. Host: smtp.titan.email, 465 (SSL) / 587 (STARTTLS).
TITAN_SMTP_HOST=smtp.titan.email
TITAN_SMTP_PORT=465
TITAN_SMTP_USER=
TITAN_SMTP_PASS=
EMAIL_FROM=

# ─── WhatsApp (Meta Cloud API) — CR-WA W1 ───────────────────────────────────
# WHATSAPP_PROVIDER selects the adapter: mock (dev/test/CI default) | meta (prod).
# `mock` is also the ROLLBACK — flip it back and restart, no deploy needed.
#
# ⚠️ SET THESE ON *BOTH* RENDER (API) AND RAILWAY (WORKER). The worker sends
# notifications; the API sends login OTPs INLINE (the documented exception in
# .claude/rules/worker-and-external-sends.md). Setting them on only one service
# leaves the other silently on the mock — and a missing/misspelled var means no
# WhatsApp is ever sent and NOTHING errors.
#
# Template names are NOT env vars — they are mapped in
# apps/api/src/notifications/channels/meta-templates.ts and validated at startup.
WHATSAPP_PROVIDER=mock
# LOCAL-DEV ONLY: with WHATSAPP_PROVIDER=mock no OTP is actually delivered, so a
# developer has no code to type. Set OTP_DEV_CODE to a fixed 6-digit code and
# EVERY issued OTP becomes that code — verification still runs the normal
# hash/expiry/attempt checks (it is not a bypass). Double-gated: ignored entirely
# when WHATSAPP_PROVIDER=meta OR NODE_ENV=production, so a leaked value is inert.
# Leave blank to keep codes random.
OTP_DEV_CODE=123456
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TIMEOUT_MS=10000
# ⚠️ The locale your templates are APPROVED in — part of a template's identity to
# Meta, not a formatting preference. `en` and `en_US` are DIFFERENT templates; a
# mismatch fails with 404 / code 132001 "template name (…) does not exist in en",
# which reads like the template is missing when it is only mis-localed. Read the
# real value off the template in WhatsApp Manager. Must be the SAME on both
# services.
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# The delivery webhook (CR-WA W2) — read by the API process (Render), which is
# what Meta calls back. WHATSAPP_VERIFY_TOKEN is a secret YOU invent and paste
# into the Meta dashboard; the two must match EXACTLY or verification fails with
# a generic error that looks like a wrong URL. WHATSAPP_APP_SECRET is Meta's App
# Secret and signs the callback body — absent means the webhook FAILS CLOSED.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# S7-B1: WORKER-only Chromium executable (Puppeteer). Leave BLANK for local dev
# (puppeteer's own downloaded Chrome is used). The Docker image sets this to
# /usr/bin/chromium-browser (apk chromium; the image build skips puppeteer's
# ~170MB download). The API process never launches a browser.
CHROMIUM_EXECUTABLE_PATH=

# ─── S8-H1: performance tuning (all OPTIONAL — the values below ARE the defaults) ───
# Measured baselines, breaking points and sizing guidance: docs/performance-report.md
# Re-runnable load scripts: load/  (pnpm load:seed, load:chromium, load:search, …)
#
# RENDER_POOL_CONCURRENCY is a MEMORY knob, not a throughput knob. MEASURED peak
# worker-process-TREE memory (node + all Chromium children), 1GB budget assumed:
#   cap 1 → ~555MB    cap 2 → ~515-680MB  (recommended for a 1GB worker)
#   cap 4 → ~1095MB   cap 8 → ~1789MB     (cap 4 ALREADY breaches 1GB)
# Raise it only together with the container's memory limit, never for throughput.
# The resume + invoice queue concurrencies together should not exceed it, so that
# surplus render jobs wait in Redis instead of inside the worker process.
RENDER_POOL_CONCURRENCY=2
RENDER_TIMEOUT_MS=30000
RENDER_RECYCLE_AFTER=50
RESUME_RENDER_CONCURRENCY=1
INVOICE_RENDER_CONCURRENCY=1

# Rate limits (api-conventions.md). NOTE: ThrottlerModule still uses IN-MEMORY
# storage, so these are enforced PER API REPLICA — see app-api.module.ts.
RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_SEARCH_PER_MIN=30

# Postgres connection pool. Prisma defaults to (num_cpus * 2 + 1) per process,
# which is invisible until a burst exhausts it and surfaces as latency that looks
# like an application problem. Set it EXPLICITLY per process and size the sum of
# (api replicas + worker) × connection_limit under Postgres' max_connections:
#   DATABASE_URL=postgresql://…/db?connection_limit=20&pool_timeout=10

# ─── Redis COMMAND BUDGET (all OPTIONAL — the values below ARE the defaults) ───
# Only matters on a PER-COMMAND Redis plan (Upstash). On self-hosted Redis these
# cost nothing and the defaults are still fine. Full derivation:
# docs/redis-command-budget.md
#
# An IDLE BullMQ worker is not free: it long-polls (BZPOPMIN) every drainDelay
# seconds and sweeps for stalled jobs every stalledInterval ms, forever, whether
# or not a job ever arrives. At BullMQ's defaults (5s / 30s) eight idle workers
# cost ~4.8M commands/month. Raising drainDelay does NOT delay job pickup —
# Queue.add() pushes a marker that wakes the blocked poll immediately; this is
# only how often an idle worker re-arms. See apps/api/src/queue/worker-tuning.ts.
BULL_DRAIN_DELAY_S=60
BULL_MAINTENANCE_DRAIN_DELAY_S=300
BULL_STALLED_INTERVAL_MS=300000
BULL_MAINTENANCE_STALLED_INTERVAL_MS=600000

# Queue-depth metrics cost 4-5 Redis commands PER QUEUE PER TICK. `bull:*` keys
# are GLOBAL, so collecting in both the API and the worker reads the same keys
# twice for identical numbers — it is worker-only by default.
#   METRICS_QUEUE_COLLECTION: on | off  (default: on iff SIC_PROCESS_ROLE=worker)
METRICS_PROCESS_INTERVAL_MS=15000
METRICS_QUEUE_INTERVAL_MS=600000
METRICS_QUEUE_COLLECTION=
