{
  "name": "skillindiaconnect",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "~5.7.2"
    }
  },
  "scripts": {
    "dev": "concurrently -n web,api,worker -c blue,green,yellow \"pnpm --filter @skillindiaconnect/web dev\" \"pnpm --filter @skillindiaconnect/api dev:api\" \"pnpm --filter @skillindiaconnect/api dev:worker\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:ui": "playwright test",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @skillindiaconnect/api db:generate",
    "db:migrate": "pnpm --filter @skillindiaconnect/api db:migrate",
    "db:seed": "pnpm --filter ./apps/api exec prisma db seed",
    "db:reset": "pnpm --filter ./apps/api exec prisma migrate reset --force",
    "contract:generate": "pnpm --filter @skillindiaconnect/contract validate && pnpm --filter @skillindiaconnect/shared-types generate",
    "check:env": "tsx scripts/check-env-drift.ts",
    "load:typecheck": "tsc -p load/tsconfig.json --noEmit",
    "load:seed": "pnpm --filter ./apps/api exec tsx ../../load/seed-load-data.ts",
    "load:chromium": "pnpm --filter ./apps/api exec tsx ../../load/chromium-pool-burst.ts",
    "load:search": "pnpm --filter ./apps/api exec tsx ../../load/search-load.ts",
    "load:webhook": "pnpm --filter ./apps/api exec tsx ../../load/webhook-load.ts",
    "load:apply": "pnpm --filter ./apps/api exec tsx ../../load/apply-load.ts",
    "security:inventory": "pnpm --filter ./apps/api exec tsx ../../security/probes/endpoint-inventory.ts",
    "security:authz": "pnpm --filter ./apps/api exec tsx ../../security/probes/authz-sweep.ts",
    "security:typecheck": "tsc -p security/probes/tsconfig.json --noEmit",
    "security:idor": "pnpm --filter ./apps/api exec tsx ../../security/probes/idor-sweep.ts",
    "security:privacy": "pnpm --filter ./apps/api exec tsx ../../security/probes/privacy-probes.ts",
    "security:injection": "pnpm --filter ./apps/api exec tsx ../../security/probes/injection-probes.ts",
    "security:webhook": "pnpm --filter ./apps/api exec tsx ../../security/probes/webhook-probes.ts",
    "security:authconfig": "pnpm --filter ./apps/api exec tsx ../../security/probes/auth-config-probes.ts",
    "security:all": "pnpm security:authz && pnpm security:idor && pnpm security:privacy && pnpm security:injection && pnpm security:webhook && pnpm security:authconfig",
    "security:matrix": "pnpm --filter ./apps/api exec tsx ../../security/probes/render-authz-matrix.ts",
    "chaos:typecheck": "tsc -p chaos/tsconfig.json --noEmit",
    "chaos:redis": "pnpm --filter ./apps/api exec tsx ../../chaos/redis-down.ts",
    "chaos:gateway": "pnpm --filter ./apps/api exec tsx ../../chaos/gateway-down.ts",
    "chaos:storage": "pnpm --filter ./apps/api exec tsx ../../chaos/storage-down.ts",
    "chaos:worker": "pnpm --filter ./apps/api exec tsx ../../chaos/worker-crash.ts",
    "chaos:nofalsesuccess": "pnpm --filter ./apps/api exec tsx ../../chaos/no-false-success.ts",
    "chaos:all": "pnpm chaos:redis && pnpm chaos:gateway && pnpm chaos:storage && pnpm chaos:worker && pnpm chaos:nofalsesuccess",
    "chaos:drill": "pnpm --filter ./apps/api exec tsx ../../chaos/backup-restore-drill.ts",
    "a11y:audit": "playwright test -c a11y/playwright.config.ts",
    "a11y:typecheck": "tsc -p a11y/tsconfig.json --noEmit",
    "a11y:contrast": "node a11y/contrast-tokens.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.44.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "axe-core": "^4.12.1",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.1.0",
    "js-yaml": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "prettier": "^3.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
